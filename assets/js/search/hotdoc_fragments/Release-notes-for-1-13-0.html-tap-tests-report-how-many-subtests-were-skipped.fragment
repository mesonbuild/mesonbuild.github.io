fragment_downloaded_cb({"url":"Release-notes-for-1-13-0.html#tap-tests-report-how-many-subtests-were-skipped","fragment":"TAP tests report how many subtests were skipped\nThe result line of a TAP test now reports how many of its subtests were\nskipped, so environment-gated subtests no longer disappear silently from\na passing test:\n"});