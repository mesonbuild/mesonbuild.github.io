fragment_downloaded_cb({"url":"Rust.html#building-static-libraries-for-no_std-environments","fragment":"Building static libraries for no_std environments\nMeson by default links all the dependencies of libstd into executables that depend\non Rust staticlibs.  Specifying b_freestanding=true lets Meson know that the\nstaticlib uses #[no_std], and reduces the set of libraries that are linked into\nits dependencies.\n"});