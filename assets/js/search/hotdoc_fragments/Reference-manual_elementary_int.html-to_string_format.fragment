fragment_downloaded_cb({"url":"Reference-manual_elementary_int.html#to_string_format","fragment":"How to format the number; can be one of 'dec' (decimal), 'hex'\n(hexadecimal), 'oct' (octal), or 'bin' (binary).\nFor formats other than 'dec', the string will be appropriately prefixed\n(e.g., for 'hex', the string will begin with '0x', etc.)\n(since 1.12.0)\ndefault =\n  'dec'\n"});